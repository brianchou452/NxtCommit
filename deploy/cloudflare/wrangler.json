{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nxtcommit-delivery",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "hackathon.ianjuan.com", "custom_domain": true }],
  "vars": {
    "DEPLOYMENT_STAGE": "infrastructure-only",
    "COMMIT_SHA": "local",
    "GITHUB_RUN_URL": "not-deployed-by-actions"
  }
}
