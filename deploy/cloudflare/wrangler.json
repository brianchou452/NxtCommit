{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nxtcommit-delivery",
  "main": "container.mjs",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "hackathon.ianjuan.com",
      "custom_domain": true
    }
  ],
  "vars": {},
  "limits": {
    "cpu_ms": 1000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "containers": [
    {
      "class_name": "NxtCommitContainer",
      "image": "../node/Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 1,
      "image_vars": {
        "COMMIT_SHA": "local",
        "GITHUB_RUN_URL": "local"
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NXTCOMMIT",
        "class_name": "NxtCommitContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "NxtCommitContainer"
      ]
    }
  ],
  "triggers": {
    "crons": []
  }
}
