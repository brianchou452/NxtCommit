# Server-only configuration. Never put API keys in VITE_ variables.
HOST=127.0.0.1
PORT=4177
VAR_DIR=./var
EXECUTION_MODE=demo
RUN_DISPATCH_MODE=inline
# Existing mission routes execute bundled fixtures; /github uses the separate opt-in runner.
# Queue mode also needs server/mission-worker.ts as a separate process.

# Responses probe and local authoring use different API permissions.
# The Cloudflare Responses credential is not automatically used by product advice.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=<server-only-public-key>
# LANGFUSE_SECRET_KEY=<server-only-secret-key>
# APP_VERSION=<source-version>
# APP_COMMIT=<immutable-source-commit>

# Optional local demo reset protection (Cloudflare always enables it).
DEMO_PROTECTED=0
# Separate operator credential for protected reset and SQLite backup.
OPENAI_CHECK_TOKEN=

# Optional initialized local self-update release root (default remains dist).
# SELF_UPDATE_ROOT=./var/self-update

# Agent-only local monitoring uses ignored var/langfuse/.env; see docs/AGENT-OPERATIONS.md.
# AGENT_TRACING_ENABLED=false
# SELF_UPDATE_VERIFIER_IMAGE=nxtcommit-agent-verifier:local

# GitHub source workspaces: local single-server use with Docker only.
# Set to 1 to allow credit commitment, draft PR creation and bounded AI execution.
# Do not enable in the current Cloudflare container (no Docker execution boundary).
GITHUB_WORKSPACES_ENABLED=0
# Exact target-repository GitHub Actions check names, separated by commas.
# "test" is an example: replace it with the real checks before using a repository.
# Missing, failed or nonmatching checks keep the PR in draft.
GITHUB_REQUIRED_CHECKS=test
# Pre-pull node:24.19.0-bookworm-slim; the server must be able to run Docker.
# OPENAI_API_KEY above is required; OPENAI_MODEL selects the Responses model.
# Enter the GitHub token in /github, not in this file or a VITE_ variable.
# Required repository permissions: Contents write, Pull requests write, Checks read.
