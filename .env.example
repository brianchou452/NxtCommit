# Optional model/trace configuration. Leave unset for labelled static/demo fallbacks.
HOST=127.0.0.1
PORT=4177
VAR_DIR=./var
EXECUTION_MODE=auto
RUN_DISPATCH_MODE=inline
# All execution modes remain refused until a runner is installed in Phase 2.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=<compatible-model-id>
# OPENAI_API_KEY=<server-only-key>
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=<server-only-public-key>
# LANGFUSE_SECRET_KEY=<server-only-secret-key>
# APP_VERSION=0.7.14
# APP_COMMIT=<immutable-source-commit>

# Optional initialized local self-update release root (default remains dist).
# SELF_UPDATE_ROOT=./var/self-update

# Agent-only local monitoring uses ignored var/langfuse/.env; see docs/AGENT-OPERATIONS.md.
# AGENT_TRACING_ENABLED=false
# SELF_UPDATE_VERIFIER_IMAGE=nxtcommit-agent-verifier:local
