# Server-only configuration. Never put API keys in VITE_ variables.
HOST=127.0.0.1
PORT=4177
VAR_DIR=./var
EXECUTION_MODE=auto
RUN_DISPATCH_MODE=inline
# All execution modes remain refused until a runner is installed in Phase 2.

# Same names are injected into the Cloudflare container at runtime.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
