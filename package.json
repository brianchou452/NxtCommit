{
  "name": "nxtcommit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k 'npm:dev:server' 'npm:dev:client'",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:foundation": "npm test",
    "test:spec-tools": "uv run python -m unittest discover -s scripts -p '*_test.py'",
    "lint:spec": "uv run python scripts/lint_specs.py",
    "lint:contracts": "uv run python scripts/lint_specs.py --contracts-only",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "check": "npm run typecheck && npm test && npm run build",
    "check-version": "node scripts/check-version.mjs",
    "test:e2e": "bash scripts/playwright-docker.sh",
    "test:visual": "bash scripts/playwright-docker.sh --project=visual --project=mission-visual --project=computer-c-visual",
    "test:server": "node scripts/run-tests.mjs",
    "agents:experiment": "node --import tsx server/resilience/cli.ts",
    "agents:update": "node --import tsx server/self-update/cli.ts",
    "agents:monitor": "node scripts/langfuse-local.mjs",
    "agents:benchmark": "node --import tsx server/agents/benchmark.ts",
    "test:e2e:github": "bash scripts/github-e2e-docker.sh"
  },
  "dependencies": {
    "@langchain/langgraph": "1.4.15",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "express": "5.2.1",
    "lucide-react": "^0.544.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.3",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/express": "5.0.6",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "9.2.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
